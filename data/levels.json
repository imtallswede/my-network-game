    {
      "id": "L1",
      "title": "Orientation Week",
      "outcomeId": "LO1",
      "concept": "Coverage: how distance and walls weaken the signal",
      "budget": 2000,
      "apLimit": 3,
      "channelMode": {
        "type": "locked",
